public class RemoveDigitToMaximize {
    public static String maximizeAfterRemoving(String numStr, char targetDigit) {
        int n = numStr.length();
        char[] s = numStr.toCharArray();
        for (int i = 0; i < n - 1; i++) {
            if (s[i] == targetDigit && s[i] < s[i + 1]) {
                return removeAtIndex(s, i);
            }
        }
        for (int i = n - 1; i >= 0; i--) {
            if (s[i] == targetDigit) {
                return removeAtIndex(s, i);
            }
        }
        return numStr;
    }

    private static String removeAtIndex(char[] s, int idx) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length; i++) {
            if (i == idx) continue;
            sb.append(s[i]);
        }
        return sb.toString();
    }
    public static void main(String[] args) {
        String number = "1321";
        char digitToRemove = '1';
        String result = maximizeAfterRemoving(number, digitToRemove);
        System.out.println("Result: " + result); // Expected: "321"
    }
}
